{
  "phases": [
    {
      "kanon": [
        { "verb": "kanon.init", "flags": ["--feature=full", "--review-trigger=labelled", "--no-sensitive-data", "--chat=none"] },
        { "verb": "register.write" },
        { "verb": "expect.init", "status": "steps-left", "findings": ["label.create", "milestone.buckets", "ruleset.first-commit"], "fields": [{ "pointer": "/pin", "equals": "{{release}}" }] }
      ],
      "act": [
        { "verb": "files.commit", "from": "kanon", "message": "Install Kanon's full feature" },
        { "verb": "bootstrap.end", "move": "record" },
        { "verb": "repo.apply", "firstCommit": true },
        { "verb": "workflow.dispatch", "workflow": "apps-check.yml" },
        { "verb": "run.await", "name": "apps-check", "workflow": "apps-check.yml", "event": "workflow_dispatch", "branch": "main", "deadline": 10 },
        { "verb": "expect.run", "run": "apps-check", "conclusion": "success", "jobs": [{ "name": "apps / Author", "conclusion": "success" }, { "name": "apps / Judge", "conclusion": "success" }], "deadline": 2 },
        { "verb": "run.await", "name": "ci", "workflow": "ci.yml", "event": "push", "branch": "main", "deadline": 10 },
        { "verb": "expect.check", "branch": "main", "name": "Lane check", "conclusion": "success", "deadline": 5 },
        { "verb": "repo.apply", "firstCommit": true },
        { "verb": "bootstrap.end", "move": "approval" }
      ]
    },
    {
      "kanon": [
        { "verb": "kanon.doctor" },
        { "verb": "expect.doctor", "status": "incomplete", "exitCode": 4, "unchecked": ["secrets"], "absent": ["ruleset.bootstrap-can-end", "ruleset.approval-off"], "fields": [{ "pointer": "/releases/pins", "equals": ["{{release}}"] }, { "pointer": "/releases/pinned", "equals": "{{release}}" }] }
      ],
      "act": []
    }
  ]
}
